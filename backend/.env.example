# "development" or "production". In production the app refuses to start with a
# default/short SECRET_KEY or a default admin password.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses SQLite:
DATABASE_URL=sqlite:///./ornamental.db
#
# For Supabase Postgres, use the SESSION POOLER string:
#   Dashboard -> Connect -> ORM / Connection string -> Session pooler
# then change the scheme from postgresql:// to postgresql+psycopg://
#
# DATABASE_URL=postgresql+psycopg://postgres.dnenfwnbynojljlzhnmo:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Auth — a single login, no signup, no users table
# ---------------------------------------------------------------------------
# Signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_EMAIL=admin@stomatalworld.local
# Either a plaintext password here...
ADMIN_PASSWORD=changeme123
# ...or better, a hash (takes precedence, so no readable password is deployed):
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Failed-login lockout: this many wrong guesses from one client and it waits.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Read the client's address from X-Forwarded-For. Only behind a proxy that sets
# it (Vercel does, and turns this on by itself) — elsewhere the header is a
# forgery that would hand a guesser a fresh allowance per request.
# TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Image storage — Supabase Storage
# ---------------------------------------------------------------------------
# Leave these blank to store uploads on local disk (development only).
SUPABASE_URL=https://dnenfwnbynojljlzhnmo.supabase.co
# SECRET. Dashboard -> Project Settings -> API Keys -> service_role.
# Never commit this and never put it in the frontend — it bypasses row-level
# security. Leave it empty here; set the real value in .env only.
SUPABASE_SERVICE_KEY=
# Create this bucket in Dashboard -> Storage, and mark it PUBLIC.
SUPABASE_BUCKET=plant-images

# Uploads are resized and re-encoded to WebP before storage.
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=80

# ---------------------------------------------------------------------------
# Who may call this API
# ---------------------------------------------------------------------------
# A JSON list. Add a custom domain here rather than changing the code.
# CORS_ORIGINS=["https://stomatalworld.vercel.app","https://plants.example.com"]
# Preview deployments get a new hostname each push, so they match a pattern.
# CORS_ORIGIN_REGEX=https://.*-stomatalworld\.vercel\.app

# Only used by the local-disk fallback.
MEDIA_ROOT=./media
MEDIA_URL=/media
