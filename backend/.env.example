# "development" or "production". In production the app refuses to start with a
# default/short SECRET_KEY or a default admin password.
ENVIRONMENT=development

# Local development uses SQLite. In production use the Supabase Postgres URI:
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
#   then change the scheme to postgresql+psycopg://
DATABASE_URL=sqlite:///./ornamental.db

# Signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- the single admin login (there is no signup) ----
ADMIN_EMAIL=admin@stomatalworld.local
# Either set a plaintext password here...
ADMIN_PASSWORD=changeme123
# ...or better, generate a hash and leave the plaintext unset:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# ---- image storage ----
# Leave the Supabase values blank to store uploads on local disk (dev only).
# Supabase dashboard -> Storage -> create a PUBLIC bucket, then:
#   Project Settings -> API -> Project URL and service_role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=plant-images

# Uploads are resized and re-encoded to WebP before storage.
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=80

# Only used by the local-disk fallback.
MEDIA_ROOT=./media
MEDIA_URL=/media
